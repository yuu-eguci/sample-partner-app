{
  "name": "shopify-app-template-node",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "debug": "node --inspect-brk index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js --ignore ./frontend",
    "serve": "cross-env NODE_ENV=production node index.js",
    "test": "vitest run"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@shopify/shopify-api": "^15.1.1",
    "@shopify/shopify-app-express": "^8.0.5",
    "@shopify/shopify-app-session-storage-sqlite": "^8.0.3",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "serve-static": "^2.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
